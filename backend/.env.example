DATABASE_URL=postgresql+psycopg://candidate_app:candidate_app@localhost:5432/candidate_intelligence
# Supabase project metadata. These values do not replace DATABASE_URL for SQLAlchemy.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Backend-only key required for Supabase Storage uploads. Never expose as NEXT_PUBLIC_*.
# SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
STORAGE_BACKEND=local
STORAGE_BUCKET=candidate-cvs
# Copy the direct or session-pooler PostgreSQL URL from Supabase Dashboard > Connect.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres
SEED_FILE=../data/Dummy Candidate Database 1000 expanded.xlsx
DATA_DIR=../data
UPLOAD_DIR=../data/uploads
# Local dev plus the exact deployed frontend origin(s) used by Vercel.
# Example: http://localhost:3000,https://recruitment-ai-your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,https://recruitementai.vercel.app